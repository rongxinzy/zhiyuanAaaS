{
  "eventDrivenGate": true,
  "orchestrator": {
    "name": "CI validation",
    "path": ".github/workflows/ci.yml",
    "callers": {
      "codeql": ".github/workflows/codeql.yml",
      "gate-tests": ".github/workflows/devops-gate-tests.yml"
    },
    "localNeeds": ["verify", "coverage-ratchet"],
    "needs": ["verify", "coverage-ratchet", "codeql", "gate-tests"]
  },
  "workflows": [
    {
      "name": "CI",
      "path": ".github/workflows/ci.yml"
    },
    {
      "name": "CodeQL",
      "path": ".github/workflows/codeql.yml"
    },
    {
      "name": "DevOps gate tests",
      "path": ".github/workflows/devops-gate-tests.yml"
    }
  ]
}
