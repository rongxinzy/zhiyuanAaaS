{
  "name": "@zhiyuan/enterprise-extension",
  "version": "0.6.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:ui",
    "build:extension": "tsup",
    "build:ui": "vite build",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:bundle && npm run verify:manifest",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.ui.json --noEmit",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs"
  },
  "dependencies": {
    "@aep/sdk-node": "https://github.com/rongxinzy/Agent-Enterprise-Protocol/releases/download/sdk-node-v0.2.0/aep-sdk-node-0.2.0.tgz",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
