{
  "name": "@zhiyuan/enterprise-extension",
  "version": "0.8.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:admin",
    "build:admin": "vite build --config vite.admin.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "serve:admin": "npm run build:admin && node scripts/serve-admin.mjs",
    "verify:admin": "npm run build:admin && node scripts/verify-admin-console.mjs",
    "verify:admin:e2e": "npm run build:admin && node scripts/verify-admin-crud-browser.mjs",
    "verify:admin:real-e2e": "npm run build:admin && node scripts/verify-admin-real-e2e.mjs",
    "verify:admin:pricing:e2e": "npm run build:admin && node scripts/verify-model-pricing-browser.mjs",
    "verify:admin:trends:e2e": "npm run build:admin && node scripts/verify-gateway-trend-browser.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:admin",
    "check:ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run verify:admin",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.admin.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "verify:knowledge:api": "node scripts/verify-knowledge-api.mjs",
    "verify:knowledge:managed": "node scripts/verify-managed-knowledge.mjs",
    "verify:knowledge:native-engine": "node scripts/verify-managed-knowledge-native-engine.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@aep/sdk-node": "https://github.com/rongxinzy/Agent-Enterprise-Protocol/releases/download/sdk-node-v0.3.0/aep-sdk-node-0.3.0.tgz",
    "@ant-design/icons": "6.3.4",
    "@ant-design/plots": "2.6.8",
    "antd": "6.6.5",
    "dayjs": "1.11.23",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
