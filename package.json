{
  "name": "@zhiyuan/enterprise-extension",
  "version": "0.8.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:ui && npm run build:admin",
    "build:admin": "vite build --config vite.admin.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "serve:admin": "npm run build:admin && node scripts/serve-admin.mjs",
    "verify:admin": "npm run build:admin && node scripts/verify-admin-console.mjs",
    "verify:admin:e2e": "npm run build:admin && node scripts/verify-admin-crud-browser.mjs",
    "verify:admin:real-e2e": "npm run build:admin && node scripts/verify-admin-real-e2e.mjs",
    "build:extension": "tsup",
    "build:ui": "vite build",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:bundle && npm run verify:manifest && npm run verify:admin",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.ui.json --noEmit && tsc --project tsconfig.admin.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:agent-control:e2e": "npm run build:extension && node scripts/verify-agent-control-e2e.mjs",
    "verify:electron-rc": "node scripts/verify-electron-rc.mjs",
    "verify:model-acceptance": "node scripts/verify-model-acceptance.mjs",
    "verify:package-inputs": "node scripts/verify-package-inputs.mjs",
    "verify:electron-package": "node scripts/verify-electron-package.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@aep/sdk-node": "https://github.com/rongxinzy/Agent-Enterprise-Protocol/releases/download/sdk-node-v0.2.15/aep-sdk-node-0.2.15.tgz",
    "@ant-design/icons": "6.3.4",
    "@base-ui/react": "^1.8.0",
    "antd": "6.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.3",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
